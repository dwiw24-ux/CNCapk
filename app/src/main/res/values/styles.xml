<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="jogImgBtnDark">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/btn_square</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="jogBtnDark">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@drawable/btn_square</item>
        <item name="android:textColor">@color/white</item>

    </style>

    <style name="TabIcon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">16dp</item>
        <item name="android:tint">@color/white</item>

    </style>

    <style name="jogBtnRed">
    <item name="android:layout_width">72dp</item>
    <item name="android:layout_height">50dp</item>
    <item name="android:background">@drawable/btn_square</item>
    <item name="android:tint">@color/red</item>

    </style>

</resources>