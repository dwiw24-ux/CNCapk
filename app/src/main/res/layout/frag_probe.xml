<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Z PROBE"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtProbeResult"
            android:text="Result: -"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Feedrate (mm/m)"
                android:textSize="14sp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/edtProbeFeed"
                android:textSize="14sp"
                android:hint="Feed : mm/min"
                android:inputType="number"
                android:text="100"
                android:gravity="end"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Distance (mm)"
            android:textSize="14sp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtProbeDist"
            android:inputType="numberDecimal"
            android:text="20"
            android:textSize="14sp"
            android:gravity="end"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Touch Plate (mm)"
            android:textSize="14sp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtProbePlate"
            android:inputType="numberDecimal"
            android:text="1.5"
            android:textSize="14sp"
            android:gravity="end"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Retract (mm)"
            android:textSize="14sp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtProbeRetract"
            android:inputType="numberDecimal"
            android:text="5"
            android:textSize="14sp"
            android:gravity="end"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnProbeZ"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_square_selector"
                android:text="PROBE Z"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@null"
                android:layout_margin="2dp"
                tools:ignore="TextSizeCheck,TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnSetZ"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_square_selector"
                android:text="SET Z = 0"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@null"
                android:layout_margin="2dp"
                tools:ignore="TextSizeCheck,TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnSafeZ"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_square_selector"
                android:text="SAFE Z"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@null"
                android:layout_margin="2dp"
                tools:ignore="TextSizeCheck,TouchTargetSizeCheck" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnSetXY"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_square_selector"
                android:text="SET X/Y = 0"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@null"
                android:layout_margin="2dp"
                tools:ignore="TextSizeCheck,TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnGoZero"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_square_selector"
                android:text="GO TO ZERO"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@null"
                android:layout_margin="2dp"
                tools:ignore="TextSizeCheck,TouchTargetSizeCheck" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
