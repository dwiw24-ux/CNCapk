<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Z PROBE"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtProbeFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Feed (mm/min)"
            android:inputType="number"
            android:text="100"
            android:textSize="12sp"
            tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />

        <EditText
            android:id="@+id/edtProbeDist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Distance (mm)"
            android:inputType="numberDecimal"
            android:text="20"
            android:textSize="12sp"
            tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />

        <EditText
            android:id="@+id/edtPlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plate Thickness (mm)"
            android:inputType="numberDecimal"
            android:text="1.6"
            android:textSize="12sp"
            tools:ignore="TouchTargetSizeCheck,TextSizeCheck" />

        <EditText
            android:id="@+id/edtRetract"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Retract Height (mm)"
            android:inputType="numberDecimal"
            android:text="5"
            android:textSize="12sp"
            tools:ignore="TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btnAutoZ"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_square_selector"
            app:backgroundTint="@null"
            android:textColor="@color/text_primary"
            android:text="AUTO Z TOUCH"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">

            <Button
                android:id="@+id/btnProbeZ"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="PROBE Z"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_square_selector"
                app:backgroundTint="@null"
                android:textColor="@color/text_primary"
                tools:ignore="TextSizeCheck" />

            <Button
                android:id="@+id/btnSetZ"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="SET Z = 0"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_square_selector"
                app:backgroundTint="@null"
                android:textColor="@color/text_primary"
                tools:ignore="TextSizeCheck" />

            <Button
                android:id="@+id/btnSafeZ"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="SAFE Z"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_square_selector"
                app:backgroundTint="@null"
                android:textColor="@color/text_primary"
                tools:ignore="TextSizeCheck" />
        </LinearLayout>
        <View
            android:layout_height="16dp"
            android:layout_width="match_parent"/>

        <TextView
            android:text="XY ZERO"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <Button
        android:id="@+id/btnSetXY"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:text="SET X/Y = 0"
        android:background="@drawable/bg_btn_square_selector"
        app:backgroundTint="@null"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:ignore="TextSizeCheck" />

    <Button
        android:id="@+id/btnGoZero"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:text="GO TO ZERO"
        android:textSize="12sp"
        android:background="@drawable/bg_btn_square_selector"
        app:backgroundTint="@null"
        android:textColor="@color/text_primary"
        tools:ignore="TextSizeCheck" />
</LinearLayout>
        <View
            android:layout_height="16dp"
            android:layout_width="match_parent"/>

        <TextView
            android:id="@+id/txtProbeResult"
            android:text="Result: -"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
