<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchVerbose"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:checked="false"
            android:gravity="end"
            android:textSize="14sp"
            android:text="Verbose Output  "
            android:textColor="@color/green"
            android:padding="0dp"
            tools:ignore="TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- CONSOLE OUTPUT -->
    <ScrollView
        android:id="@+id/scrollConsole"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1"
        android:background="@drawable/dro_background"
        android:fillViewport="true">

        <TextView
            android:id="@+id/txtConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF7F"
            android:layout_margin="8dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace"
            tools:ignore="SpeakableTextPresentCheck" />
    </ScrollView>

    <!-- INPUT BAR -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/edtCommand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/green"
            android:hint="Input Command GRBL"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_btn_square_selector"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/white"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck,SpeakableTextPresentCheck,SpeakableTextPresentCheck,TouchTargetSizeCheck" />
    </LinearLayout>


</LinearLayout>
