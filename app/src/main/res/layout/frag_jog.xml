<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- STEP -->

    <TextView
        android:id="@+id/txtStep"
        android:text="Step: 1.0 mm"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content" />

    <SeekBar
        android:id="@+id/seekStep"
        android:max="100"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"/>

    <!-- FEED -->

    <TextView
        android:id="@+id/txtFeed"
        android:text="Feed: 500 mm/menit"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"/>

    <SeekBar
        android:id="@+id/seekFeed"
        android:max="4000"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"/>

    <!-- JOG PAD -->

    <GridLayout
        android:rowCount="3"
        android:columnCount="5"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnYPlus"
            android:contentDescription="Y+"
            android:src="@drawable/ic_up"
            android:layout_row="0"
            android:layout_column="1"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>
        <ImageButton
            android:id="@+id/btnZPlus"
            android:contentDescription="Z+"
            android:src="@drawable/ic_up"
            android:layout_row="0"
            android:layout_column="4"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>
        <ImageButton
            android:id="@+id/btnXMinus"
            android:contentDescription="X-"
            android:src="@drawable/ic_left"
            android:layout_row="1"
            android:layout_column="0"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>
        <ImageButton
            android:id="@+id/btnHoming"
            android:contentDescription="Home"
            android:src="@drawable/ic_home"
            android:layout_row="1"
            android:layout_column="1"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>
        <ImageButton
            android:id="@+id/btnXPlus"
            android:contentDescription="X+"
            android:src="@drawable/ic_right"
            android:layout_row="1"
            android:layout_column="2"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>
        <ImageButton
            android:id="@+id/btnStop"
            android:contentDescription="Stp"
            android:src="@drawable/ic_stop"
            android:layout_row="1"
            android:layout_column="4"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>
        <ImageButton
            android:id="@+id/btnYMinus"
            android:contentDescription="Y-"
            android:src="@drawable/ic_down"
            android:layout_row="2"
            android:layout_column="1"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>
        <ImageButton
            android:id="@+id/btnZMinus"
            android:contentDescription="Z-"
            android:src="@drawable/ic_down"
            android:layout_row="2"
            android:layout_column="4"
            android:scaleType="centerInside"
            style="@style/jogImgBtnDark"/>

    </GridLayout>
</LinearLayout>